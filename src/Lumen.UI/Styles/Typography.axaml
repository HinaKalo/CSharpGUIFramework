<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Typography scale. Usage: <TextBlock Classes="title" Text="..." />
    Modifiers combine: Classes="caption secondary", Classes="body strong"
  -->

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Display}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.8" />
    <Setter Property="LineHeight" Value="44" />
  </Style>

  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="LineHeight" Value="36" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Body}" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource Lumen.FontSize.Caption}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextTertiary}" />
  </Style>

  <!-- Modifiers -->
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.medium">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.AccentText}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.SuccessText}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.WarningText}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Lumen.Brush.DangerText}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Lumen.Font.Mono}" />
  </Style>
</Styles>
