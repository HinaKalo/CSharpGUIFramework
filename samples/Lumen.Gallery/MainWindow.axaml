<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://github.com/HinaKalo/lumen"
        x:Class="Lumen.Gallery.MainWindow"
        Title="Lumen UI Gallery"
        Width="1280" Height="840"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Gallery-only layout helpers -->
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="36,28,36,48" />
      <Setter Property="Spacing" Value="28" />
      <Setter Property="MaxWidth" Value="1120" />
    </Style>
    <Style Selector="WrapPanel.row > :is(Control)">
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style Selector="StackPanel.section">
      <Setter Property="Spacing" Value="14" />
    </Style>
  </Window.Styles>

  <l:AppShell x:Name="Shell"
              Title="Lumen UI"
              Subtitle="Component gallery">
    <l:AppShell.HeaderActions>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <l:SearchBox Width="240" PlaceholderText="Search components" Margin="0,0,6,0" />
        <Button Classes="ghost icon" ToolTip.Tip="Accent color">
          <l:Icon Kind="Droplet" Size="17" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="10" Margin="4">
                <TextBlock Classes="overline" Text="ACCENT" />
                <WrapPanel x:Name="AccentSwatches" MaxWidth="168" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <l:ThemeToggleButton />
        <Button Classes="ghost icon" ToolTip.Tip="Notifications">
          <l:Icon Kind="Bell" Size="17" />
        </Button>
        <l:Avatar DisplayName="Hina Kalo" Size="32" Status="Online" Margin="8,0,0,0" />
      </StackPanel>
    </l:AppShell.HeaderActions>

    <l:AppShell.PaneFooter>
      <l:Card Classes="subtle compact" Padding="12">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <l:Badge Classes="accent" Content="v0.1" />
            <TextBlock Classes="caption secondary" Text="Avalonia 12 · .NET 10" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption tertiary" Text="MIT licensed · built for speed" />
        </StackPanel>
      </l:Card>
    </l:AppShell.PaneFooter>
  </l:AppShell>
</Window>
