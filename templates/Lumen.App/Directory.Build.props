<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Versions live in the .csproj; stay independent of any parent repo's central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Version>0.1.0</Version>
<!--#if (UseProjectReference) -->

    <!-- Lumen.UI source project: relative to this folder, or an absolute path. -->
    <LumenUiProject>LUMEN_UI_PROJECT_PATH</LumenUiProject>
    <LumenUiProjectFullPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(LumenUiProject)'))</LumenUiProjectFullPath>
<!--#else -->

    <!-- Lumen.UI NuGet package version. -->
    <LumenUiVersion>LUMEN_UI_VERSION</LumenUiVersion>
<!--#endif -->
  </PropertyGroup>
</Project>
